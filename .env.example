# Copy to `.env` and fill in for local development. NEVER commit a real `.env`.
# In production these are set on Render (see render.yaml); secrets use sync:false.

# --- Core ---------------------------------------------------------------------
# Postgres connection string. Locally, matches the docker-compose Postgres.
DATABASE_URL=postgres://admin:admin@localhost:5432/wedding
# Web server port.
PORT=8080

# --- Admin access -------------------------------------------------------------
# Comma-separated emails allowed into /admin. Everyone else gets a 404.
ADMIN_ALLOWLIST=you@example.com
# Signs the admin session cookie (>= 32 bytes). Generate a strong random value
# in production; Render generates one automatically.
SESSION_SECRET=dev-only-insecure-session-secret-change-me-0123456789
# Set false for local HTTP so the session cookie isn't marked Secure.
SESSION_COOKIE_SECURE=false
# Enables POST /admin/dev-login to establish a session without Google SSO.
# Local development only — leave unset/false in production.
ADMIN_DEV_LOGIN=true

# --- Google SSO + ingestion (all four required to enable Google features) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:8080/admin/auth/google/callback
# Prod:  https://baicebo.com/admin/auth/google/callback  (register both in the
#        Google Cloud console OAuth client)
GOOGLE_REDIRECT_URI=http://localhost:8080/admin/auth/google/callback
# Secret used to derive the AES key that encrypts Google tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- OpenAI extraction (optional; unset disables /admin/extract) --------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Max sources processed per extraction pass (cost cap).
LLM_MAX_BATCH=25
